#!/usr/bin/env bash
# =====================================================================
# 밀기 전에 **배포 전 벽**을 돌린다 (§13.125)
#
# ★ 왜 여기까지 왔나 — CI 는 빨개지지만 **머지를 막지는 못한다.**
#   비공개 저장소 + 무료 플랜이라 브랜치 보호와 룰셋을 못 쓴다(403).
#   PR 에 빨간 X 가 떠도 **버튼은 눌린다.** 실제로 확인했다(PR #1).
#   그래서 **막는 자리**는 여기다 — 올라가기 전, 내 기계에서.
#
#   CI 가 쓸모없다는 뜻이 아니다. CI 는 **기록**이고(브랜치·PR·시간이 남는다),
#   훅은 **문**이다. 훅은 `--no-verify` 로 열 수 있고 git 이 원래 그렇다 —
#   숨기지 않는다. 다만 **열려면 일부러 열어야** 한다.
#
# ★ 켜는 법 (저장소마다 한 번):
#     git config core.hooksPath .githooks
#
# ★ `db/` 가 안 바뀐 밀기는 **그냥 지나간다**(5초도 아깝다).
# =====================================================================
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
red(){ printf "\033[31m%s\033[0m\n" "$*"; }

# 미는 범위에 db/ 변경이 있나 — pre-push 는 stdin 으로 ref 들을 받는다
touched=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue   # 브랜치 삭제
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")     # 새 브랜치
  else
    base="$remote_sha"
  fi
  rng="${base:+$base..}$local_sha"
  git diff --name-only "$rng" 2>/dev/null | grep -q '^db/' && touched=1
done
[ "$touched" -eq 1 ] || exit 0

echo "── 밀기 전 검증 (db/ 가 바뀌었다) ─────────────────────────"
if ! out=$("$ROOT/db/local/verify.sh" 2>&1); then
  echo "$out" | grep -E "구멍|①|②|FAIL|ERROR|===" | tail -20
  echo
  red "밀지 않는다. 위를 고치고 다시 민다."
  red "(정말 밀어야 하면 git push --no-verify — 하지만 그건 벽을 여는 것이다)"
  exit 1
fi
echo "$out" | grep -E "배포 전 벽|OK   민감한|전부 통과|표류" | sed 's/^/  /'
